FROM docker.io/library/node:20-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN npm ci --workspace=@quizzical/shared --workspace=@quizzical/api --include-workspace-root
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @quizzical/shared \
 && test -f packages/shared/dist/index.d.ts \
 && npm run build -w @quizzical/api \
 && npm prune --omit=dev

FROM docker.io/library/node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    MEDIA_DIR=/data/media \
    HOME=/app
# OpenShift-friendly: writable by arbitrary non-root UID
RUN mkdir -p /data/media \
 && chown -R 1001:0 /app /data \
 && chmod -R g+rwX /app /data
COPY --from=build --chown=1001:0 /app/node_modules ./node_modules
COPY --from=build --chown=1001:0 /app/packages/shared ./packages/shared
COPY --from=build --chown=1001:0 /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=1001:0 /app/apps/api/migrations ./apps/api/migrations
COPY --from=build --chown=1001:0 /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=1001:0 /app/package.json ./
USER 1001
WORKDIR /app/apps/api
EXPOSE 4000
CMD ["node", "dist/index.js"]
