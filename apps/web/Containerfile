FROM docker.io/library/node:20-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace=@quizzical/shared --workspace=@quizzical/web --include-workspace-root
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build -w @quizzical/shared && npm run build -w @quizzical/web

FROM docker.io/library/nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx /var/run /tmp \
 && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /tmp \
 && chmod -R g+rwX /usr/share/nginx/html /var/cache/nginx /var/run /tmp
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
