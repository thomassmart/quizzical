# Database
DATABASE_URL=postgres://quizzical:quizzical@localhost:5432/quizzical

# Host auth
HOST_PASSWORD=changeme
JWT_SECRET=dev-jwt-secret-change-in-production

# MCP Streamable HTTP (optional — leave empty to disable POST /mcp)
# MCP_TOKEN=generate-a-long-random-token

# Server
PORT=4000
MEDIA_DIR=./media
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# LiteMaaS / OpenAI-compatible LLM (optional — gameplay works without it)
# Base URL should be the host root OR .../v1 (both accepted)
LLM_BASE_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-oss-20b
LLM_EMBED_MODEL=nomic-embed-text-v1-5
LLM_FALLBACK_CHAT_MODEL=granite-3-2-8b-instruct

# Similarity threshold for semantic near-duplicates (0–1 cosine)
SEMANTIC_SIMILARITY_THRESHOLD=0.88
